# GEMINI_API_KEY: Required for Gemini AI API fallback/calls.
# In Vercel: Project Settings -> Environment Variables -> GEMINI_API_KEY
GEMINI_API_KEY=""

# XAI_API_KEY / GROK_API_KEY: xAI Grok API Key
# In Vercel: Project Settings -> Environment Variables -> XAI_API_KEY
XAI_API_KEY=""
GROK_API_KEY=""

# XAI_MODEL: Model to use for xAI (e.g., grok-2-latest, grok-2, grok-beta)
XAI_MODEL="grok-2-latest"

# APP_URL: URL where the app is hosted
APP_URL=""
